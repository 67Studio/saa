local espEnabled = false
local espColor = Color3.fromRGB(255, 255, 255)
local espRainbow = false
local espConnections = {}

function createESP(player)
    if not player.Character or not player.Character:FindFirstChild('HumanoidRootPart') then 
        print("[IRVING HUB] ADVERTENCIA: Player " .. player.Name .. " sin personaje o rootpart")
        return 
    end
    if player.Character:FindFirstChild('ESP_Info') then 
        print("[IRVING HUB] ESP ya existente para: " .. player.Name)
        return 
    end
    
    print("[IRVING HUB] Creando ESP para: " .. player.Name)
    
    local highlight = Instance.new('Highlight')
    highlight.Name = 'ESP_Highlight'
    highlight.Adornee = player.Character
    highlight.FillColor = espColor
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(0,0,0)
    highlight.OutlineTransparency = 0
    highlight.Parent = player.Character
    
    local billboard = Instance.new('BillboardGui')
    billboard.Name = 'ESP_Info'
    billboard.Adornee = player.Character:FindFirstChild('HumanoidRootPart')
    billboard.Size = UDim2.new(0, 150, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = player.Character
    
    local nameLabel = Instance.new('TextLabel')
    nameLabel.Size = UDim2.new(1, 0, 0.2, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = espColor
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.Code
    nameLabel.Parent = billboard
    
    local distLabel = Instance.new('TextLabel')
    distLabel.Size = UDim2.new(1, 0, 0.2, 0)
    distLabel.Position = UDim2.new(0, 0, 0.2, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = 'Distancia: 0'
    distLabel.TextColor3 = espColor
    distLabel.TextStrokeTransparency = 0
    distLabel.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    distLabel.TextScaled = true
    distLabel.Font = Enum.Font.Code
    distLabel.Parent = billboard
    
    local ageLabel = Instance.new('TextLabel')
    ageLabel.Size = UDim2.new(1, 0, 0.2, 0)
    ageLabel.Position = UDim2.new(0, 0, 0.4, 0)
    ageLabel.BackgroundTransparency = 1
    ageLabel.Text = 'Edad: ' .. player.AccountAge .. ' días'
    ageLabel.TextColor3 = espColor
    ageLabel.TextStrokeTransparency = 0
    ageLabel.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    ageLabel.TextScaled = true
    ageLabel.Font = Enum.Font.Code
    ageLabel.Parent = billboard
    
    local healthLabel = Instance.new('TextLabel')
    healthLabel.Size = UDim2.new(1, 0, 0.2, 0)
    healthLabel.Position = UDim2.new(0, 0, 0.6, 0)
    healthLabel.BackgroundTransparency = 1
    healthLabel.Text = 'Vida: 0'
    healthLabel.TextColor3 = espColor
    healthLabel.TextStrokeTransparency = 0
    healthLabel.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    healthLabel.TextScaled = true
    healthLabel.Font = Enum.Font.Code
    healthLabel.Parent = billboard
    
    local sitLabel = Instance.new('TextLabel')
    sitLabel.Size = UDim2.new(1, 0, 0.2, 0)
    sitLabel.Position = UDim2.new(0, 0, 0.8, 0)
    sitLabel.BackgroundTransparency = 1
    sitLabel.Text = 'Sentado: No'
    sitLabel.TextColor3 = espColor
    sitLabel.TextStrokeTransparency = 0
    sitLabel.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    sitLabel.TextScaled = true
    sitLabel.Font = Enum.Font.Code
    sitLabel.Parent = billboard
    
    local conn = RunService.Stepped:Connect(function()
        if not espEnabled or not player.Character or not player.Character:FindFirstChild('HumanoidRootPart') then
            if billboard then billboard:Destroy() end
            if highlight then highlight:Destroy() end
            conn:Disconnect()
            return
        end
        
        local humanoid = player.Character:FindFirstChildOfClass('Humanoid')
        local root = player.Character.HumanoidRootPart
        local lpRoot = LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
        
        if root and lpRoot then
            local dist = (root.Position - lpRoot.Position).Magnitude
            distLabel.Text = string.format('Distancia: %.2f', dist)
        end
        
        if humanoid then
            healthLabel.Text = 'Vida: ' .. math.floor(humanoid.Health)
            sitLabel.Text = humanoid.Sit and 'Sentado: Si' or 'Sentado: No'
        end
        
        if espRainbow then
            local color = Color3.fromHSV(tick() * 0.05 % 1, 1, 1)
            highlight.FillColor = color
            nameLabel.TextColor3 = color
            distLabel.TextColor3 = color
            ageLabel.TextColor3 = color
            healthLabel.TextColor3 = color
            sitLabel.TextColor3 = color
        else
            highlight.FillColor = espColor
            nameLabel.TextColor3 = espColor
            distLabel.TextColor3 = espColor
            ageLabel.TextColor3 = espColor
            healthLabel.TextColor3 = espColor
            sitLabel.TextColor3 = espColor
        end
    end)
    
    table.insert(espConnections, conn)
end

ESPTab:CreateToggle({
    Name = "ESP",
    CurrentValue = false,
    Callback = function(value)
        espEnabled = value
        print("[IRVING HUB] ESP: " .. tostring(value))
        if value then
            print("[IRVING HUB] Activando ESP para todos los jugadores...")
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LP then
                    createESP(player)
                end
            end
            Players.PlayerAdded:Connect(function(player)
                player.CharacterAdded:Connect(function()
                    if espEnabled and player ~= LP then
                        createESP(player)
                    end
                end)
            end)
            print("[IRVING HUB] ESP activado correctamente")
        else
            print("[IRVING HUB] Desactivando ESP...")
            for _, conn in pairs(espConnections) do
                conn:Disconnect()
            end
            espConnections = {}
            for _, player in pairs(Players:GetPlayers()) do
                if player.Character then
                    if player.Character:FindFirstChild('ESP_Info') then
                        player.Character.ESP_Info:Destroy()
                    end
                    if player.Character:FindFirstChild('ESP_Highlight') then
                        player.Character.ESP_Highlight:Destroy()
                    end
                end
            end
            print("[IRVING HUB] ESP desactivado correctamente")
        end
    end
})

