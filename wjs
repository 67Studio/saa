-- Variables para ver
local viewing = false
local viewTarget = nil
local viewConnection = nil

function stopViewing()
    viewing = false
    viewTarget = nil
    if viewConnection then
        viewConnection:Disconnect()
        viewConnection = nil
        print("[IRVING HUB] Vista detenida")
    end
    if LP.Character then
        Camera.CameraSubject = LP.Character
    end
end

function setViewTarget(name)
    local player = Players:FindFirstChild(name)
    if player then
        viewTarget = player
        print("[IRVING HUB] Viendo a: " .. player.Name)
        if viewConnection then
            viewConnection:Disconnect()
        end
        viewConnection = player.CharacterAdded:Connect(function(char)
            task.wait(0.1)
            local root = char:FindFirstChild('HumanoidRootPart')
            if root and viewing then
                local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                local pos = root.CFrame + root.CFrame.LookVector * -10 + Vector3.new(0,5,0)
                TweenService:Create(Camera, tweenInfo, {
                    CFrame = CFrame.new(pos.Position, root.Position)
                }):Play()
                pcall(function() Camera.CameraSubject = char end)
            end
        end)
        local root = player.Character and player.Character:FindFirstChild('HumanoidRootPart')
        if root then
            local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            local pos = root.CFrame + root.CFrame.LookVector * -10 + Vector3.new(0,5,0)
            TweenService:Create(Camera, tweenInfo, {
                CFrame = CFrame.new(pos.Position, root.Position)
            }):Play()
            pcall(function() Camera.CameraSubject = player.Character end)
        end
    else
        print("[IRVING HUB] ADVERTENCIA: Jugador no encontrado: " .. name)
    end
end

RunService.RenderStepped:Connect(function()
    if viewing and viewTarget then
        if not viewTarget:IsDescendantOf(game) then
            stopViewing()
            return
        end
        if viewTarget.Character and Camera.CameraSubject ~= viewTarget.Character then
            pcall(function() Camera.CameraSubject = viewTarget.Character end)
        end
    end
end)
