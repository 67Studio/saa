OthersTab:CreateButton({
    Name = "Copiar Avatar",
    Callback = function()
        if not selectedPlayer then 
            print("[IRVING HUB] ADVERTENCIA: No hay jugador seleccionado")
            return 
        end
        print("[IRVING HUB] Copiando avatar de: " .. selectedPlayer)
        local target = Players:FindFirstChild(selectedPlayer)
        if target and target.Character then
            local humanoid = LP.Character and LP.Character:FindFirstChildOfClass('Humanoid')
            local tHumanoid = target.Character:FindFirstChildOfClass('Humanoid')
            if humanoid and tHumanoid then
                local desc = humanoid:GetAppliedDescription()
                for _, acc in pairs(desc:GetAccessories(true)) do
                    if acc.AssetId and tonumber(acc.AssetId) then
                        remotes.Wear:InvokeServer(tonumber(acc.AssetId))
                        task.wait(0.2)
                    end
                end
                if tonumber(desc.Shirt) then remotes.Wear:InvokeServer(tonumber(desc.Shirt)); task.wait(0.2) end
                if tonumber(desc.Pants) then remotes.Wear:InvokeServer(tonumber(desc.Pants)); task.wait(0.2) end
                if tonumber(desc.Face) then remotes.Wear:InvokeServer(tonumber(desc.Face)); task.wait(0.2) end
                
                local tDesc = tHumanoid:GetAppliedDescription()
                remotes.ChangeCharacterBody:InvokeServer(tDesc.Torso, tDesc.RightArm, tDesc.LeftArm, tDesc.RightLeg, tDesc.LeftLeg, tDesc.Head)
                task.wait(0.5)
                
                if tonumber(tDesc.Shirt) then remotes.Wear:InvokeServer(tonumber(tDesc.Shirt)); task.wait(0.3) end
                if tonumber(tDesc.Pants) then remotes.Wear:InvokeServer(tonumber(tDesc.Pants)); task.wait(0.3) end
                if tonumber(tDesc.Face) then remotes.Wear:InvokeServer(tonumber(tDesc.Face)); task.wait(0.3) end
                
                for _, acc in pairs(tDesc:GetAccessories(true)) do
                    if acc.AssetId and tonumber(acc.AssetId) then
                        remotes.Wear:InvokeServer(tonumber(acc.AssetId))
                        task.wait(0.3)
                    end
                end
                
                local bodyColors = target.Character:FindFirstChild('Body Colors')
                if bodyColors then remotes.ChangeBodyColor:FireServer(tostring(bodyColors.HeadColor)); task.wait(0.3) end
                if tonumber(tDesc.IdleAnimation) then remotes.Wear:InvokeServer(tonumber(tDesc.IdleAnimation)); task.wait(0.3) end
                
                local bag = target:FindFirstChild('PlayersBag')
                if bag then
                    if bag:FindFirstChild('RPName') and bag.RPName.Value ~= '' then
                        remotes.RPNameText:FireServer('RolePlayName', bag.RPName.Value)
                        task.wait(0.3)
                    end
                    if bag:FindFirstChild('RPBio') and bag.RPBio.Value ~= '' then
                        remotes.RPNameText:FireServer('RolePlayBio', bag.RPBio.Value)
                        task.wait(0.3)
                    end
                    if bag:FindFirstChild('RPNameColor') then
                        remotes.RPNameColor:FireServer('PickingRPNameColor', bag.RPNameColor.Value)
                        task.wait(0.3)
                    end
                    if bag:FindFirstChild('RPBioColor') then
                        remotes.RPNameColor:FireServer('PickingRPBioColor', bag.RPBioColor.Value)
                        task.wait(0.3)
                    end
                end
                print("[IRVING HUB] Avatar copiado correctamente de: " .. selectedPlayer)
            else
                print("[IRVING HUB] ADVERTENCIA: Humanoid no encontrado en el jugador objetivo")
            end
        else
            print("[IRVING HUB] ADVERTENCIA: Jugador objetivo no encontrado o sin personaje")
        end
    end
})

