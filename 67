-- ═══ HTTP helper ═══
local function httpRequest(opts)
    local fn = (syn and syn.request) or (http and http.request) or request or http_request
    if fn then
        local res = fn(opts)
        if not res then error("Sin respuesta HTTP") end
        return res.StatusCode, res.Body
    end
    local res = HttpService:RequestAsync(opts)
    return res.StatusCode, res.Body
end

-- ═══ AUTH ANÓNIMA ═══
local function signInAnonymously()
    local url = "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=" .. FIREBASE_API_KEY
    local code, raw = httpRequest({
        Url = url, Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode({returnSecureToken = true}),
    })
    if code ~= 200 then error("Auth falló: " .. tostring(raw)) end
    local data = HttpService:JSONDecode(raw)
    idToken = data.idToken
    myUid = data.localId
    refreshToken = data.refreshToken
    tokenExpiresAt = os.clock() + (tonumber(data.expiresIn) or 3600) - 120
end

-- El idToken caduca a la hora: se renueva con el refreshToken
local function ensureToken()
    if os.clock() < tokenExpiresAt then return end
    local code, raw = httpRequest({
        Url = "https://securetoken.googleapis.com/v1/token?key=" .. FIREBASE_API_KEY,
        Method = "POST",
        Headers = {["Content-Type"] = "application/x-www-form-urlencoded"},
        Body = "grant_type=refresh_token&refresh_token=" .. refreshToken,
    })
    if code ~= 200 then
        signInAnonymously() -- si falla la renovación, login nuevo
        return
    end
    local data = HttpService:JSONDecode(raw)
    idToken = data.id_token
    refreshToken = data.refresh_token
    tokenExpiresAt = os.clock() + (tonumber(data.expires_in) or 3600) - 120
end

