-- ═══ ANIMACIONES DE TAGS ═══
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

-- Recorre una lista de colores de forma suave (velocidad = vueltas por segundo)
local function gradient(colors, t, speed)
    local n = #colors
    local pos = (t * speed) % n
    local i = math.floor(pos) + 1
    local a, b = colors[i], colors[i % n + 1]
    return a:Lerp(b, pos - math.floor(pos))
end

-- Late entre dos colores
local function pulse(c1, c2, t, speed)
    return c1:Lerp(c2, (math.sin(t * speed) + 1) / 2)
end

-- Cambia de golpe entre colores (parpadeo)
local function blink(colors, t, speed)
    return colors[math.floor(t * speed) % #colors + 1]
end

