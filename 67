local polling = false
local pollInner

-- Evita que dos lecturas se ejecuten a la vez (la del bucle y la de enviar mensaje)
poll = function()
    if polling then return end
    polling = true
    local ok, err = pcall(pollInner)
    polling = false
    if not ok then error(err, 0) end
end

pollInner = function()
    local requestedChannel = channel
    local node = "messages/" .. requestedChannel
    local nowMs = math.floor(os.time() * 1000)

    local url = dbUrl(node, "orderBy=%22timestamp%22&startAt=" .. (nowMs - TTL_MS))
    local code, raw = httpRequest({Url = url, Method = "GET", Headers = authHeaders()})
    if code ~= 200 then error("Lectura " .. tostring(code) .. ": " .. tostring(raw)) end
    if channel ~= requestedChannel then return end -- cambiaste de canal mientras cargaba
    if raw == "null" then refreshPeers({}); return end

    local data = HttpService:JSONDecode(raw)
    if type(data) ~= "table" then return end

    local list = {}
    for id, m in pairs(data) do m._id = id; table.insert(list, m) end
    table.sort(list, function(a, b) return (a.timestamp or 0) < (b.timestamp or 0) end)

    local peers = {}
    local peerSeen = {}
    for _, m in ipairs(list) do
        m.senderName = cleanName(m.senderName)
        local sameServer = requestedChannel ~= "server" or m.jobId == game.JobId
        -- Privados: solo los ve quien lo envía y a quien va dirigido
        local visible = (m.target == nil or m.target == "")
            or tostring(m.target) == myUserId or tostring(m.senderId) == myUserId
        if sameServer and visible then
            if not seenIds[m._id] then
                seenIds[m._id] = true
                func7(m.senderName, m.body, m.senderName, false, m.target, m.senderId, 0, m.avatarUrl)
                if tostring(m.senderId) ~= myUserId then
                    func5(tostring(m.senderId) == BOT_ID and "[BOT]" or m.senderName, m.body, m.senderId)
                end
            end
            -- Un usuario solo una vez en la lista (aunque tenga varios mensajes)
            local sid = tostring(m.senderId)
            if sid ~= BOT_ID and not peerSeen[sid] then
                peerSeen[sid] = true
                table.insert(peers, {alias = m.senderName, id = m.senderId, self = sid == myUserId})
            end
        end
    end
    refreshPeers(peers)

    task.spawn(function()
        local cutoff = nowMs - TTL_MS
        local cleanUrl = dbUrl(node, "orderBy=%22timestamp%22&endAt=" .. cutoff)
        local cCode, cRaw = httpRequest({Url = cleanUrl, Method = "GET", Headers = authHeaders()})
        if cCode == 200 and cRaw ~= "null" then
            local old = HttpService:JSONDecode(cRaw)
            if type(old) == "table" then
                for id in pairs(old) do
                    pcall(function()
                        httpRequest({
                            Url = dbUrl(node .. "/" .. id),
                            Method = "DELETE",
                            Headers = authHeaders(),
                        })
                    end)
                end
            end
        end
    end)
end

local sending = false
local function sendMessage()
    if sending then return end
    local blocked, detail = func2(textBox.Text)
    local body = func1(textBox.Text)
    if blocked or body == "" or #body > MAX_BODY then
        func7(nil, blocked and detail or "Máximo 200 caracteres", nil, true)
        return
    end
    if os.clock() - num < 3 then return end
    num = os.clock(); sending = true

    local avatarUrl = ""
    pcall(function()
        avatarUrl = Players:GetUserThumbnailAsync(me.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
    end)

    local nowMs = math.floor(os.time() * 1000)
    local msgId = "msg_" .. myUserId .. "_" .. tostring(nowMs)
    -- Los privados van al canal actual con "target"; las reglas no tienen nodo "private"
    local node = "messages/" .. channel

    local payload = {
        senderId = myUserId,
        senderName = me.DisplayName,
        body = body,
        avatarUrl = avatarUrl,
        timestamp = nowMs,
        target = targetId,
        jobId = channel == "server" and game.JobId or nil,
    }

    local sent, code, result = pcall(function()
        return httpRequest({
            Url = dbUrl(node .. "/" .. msgId),
            Method = "PUT",
            Headers = authHeaders(),
            Body = HttpService:JSONEncode(payload),
        })
    end)
    if sent and code ~= 200 then
        sent = false
        result = tostring(code) .. " " .. tostring(result)
    elseif not sent then
        result = code
    end

    if sent then
        textBox.Text = ""
        pcall(poll)
    else
        func7(nil, "No enviado: " .. tostring(result), nil, true)
    end
    sending = false
end

