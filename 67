local function func1(arg1)
    if not arg1 then return "" end
    local v1 = arg1:gsub("<[^>]*>", ""):gsub("[<>]", ""):gsub("[\204-\205][\128-\191]", ""):gsub("%s+", " ")
    return v1:match("^%s*(.-)%s*$") or v1
end

-- Escapa caracteres especiales del RichText (& < > " ')
local function esc(s)
    s = tostring(s or "")
    s = s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&apos;")
    return s
end

-- Limpia nombres que vienen de Firebase: sin etiquetas, sin saltos, máx. 20 caracteres
local function cleanName(s)
    if type(s) ~= "string" then s = tostring(s or "?") end
    s = func1(s):gsub("[%c]", "")
    local len = utf8.len(s)
    if len and len > 20 then s = s:sub(1, utf8.offset(s, 21) - 1) end
    if s == "" then s = "?" end
    return s
end

local function func2(arg1)
    if arg1:find("<[^>]*>") then return true, "HTML tags not allowed" end
    if arg1:find("[<>]") then return true, "Angle brackets not allowed" end
    if arg1:find("[\204-\205][\128-\191]") then return true, "Zalgo text not allowed" end
    local v1 = arg1:gsub("[^%a]", "")
    if #v1 > 0 and v1:match("(.)%1{15,}") then return true, "Too many repeated letters" end
    if #v1 > 10 then
        local v2 = select(2, v1:gsub("%u", ""))
        if v2 / #v1 > 0.8 and v2 > 15 then return true, "Too many capital letters" end
    end
    return false, arg1
end

