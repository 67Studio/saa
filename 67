RunService.Heartbeat:Connect(function()
    local time = tick()
    for _, entry in ipairs(messageRows) do
        local row = entry.row
        if row and row.Parent and row:GetAttribute("HasAnim") then
            local content = row:GetAttribute("Content") or ""
            local name = row:GetAttribute("RealName") or "?"
            local tagName = row:GetAttribute("TagName") or ""
            local prefix = row:GetAttribute("Prefix") or ""
            local animType = TagColors[tagName]
            local nameColor = func6(name)
            local tagHex

            local tagText
            if animType == "SMOOTH_RAINBOW" then
                -- Arcoíris letra a letra que fluye despacio por el tag
                local parts = {}
                local chars = {}
                for _, cp in utf8.codes("[" .. tagName .. "]") do table.insert(chars, utf8.char(cp)) end
                for i, ch in ipairs(chars) do
                    local hue = (time / 6 - i / (#chars * 1.5)) % 1 -- 6 s por vuelta
                    local c = Color3.fromHSV(hue, 0.65, 1)       -- colores suaves (pastel)
                    table.insert(parts, string.format('<font color="#%s">%s</font>', c:ToHex(), ch))
                end
                tagText = table.concat(parts)
            else
                local anim = Animations[animType]
                if anim then
                    tagHex = "#" .. anim(time):ToHex()
                else
                    tagHex = normColor(animType) -- color fijo
                end
                tagText = string.format('<font color="%s">[%s]</font>', tagHex, tagName)
            end

            row.Text = string.format(
                '%s%s <font color="#%s">[%s]</font>: <font face="BuilderSansMedium">%s</font>',
                prefix, tagText, nameColor:ToHex(), name, content)
        end
    end
end)

