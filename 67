-- ═══ TAGS Y COLORES DESDE GITHUB ═══
local TagColors = {}
local RankRegistry = {}

-- Normaliza colores: "ff33e6" -> "#ff33e6". Las palabras de animación (RAINBOW, FIRE...) se dejan igual
local function normColor(c)
    if type(c) ~= "string" or c == "" then return "#FFFFFF" end
    if c:match("^%x%x%x%x%x%x$") then return "#" .. c end
    return c
end

local function loadTags()
    local ok, raw = pcall(function() return game:HttpGet(TAG_URL) end)
    if not ok or not raw or raw == "" then
        warn("[KAZE Chat] No se pudieron cargar los tags")
        return
    end
    local okJson, json = pcall(function() return HttpService:JSONDecode(raw) end)
    if okJson and type(json) == "table" then
        for id, data in pairs(json) do
            if type(data) == "table" then
                table.insert(RankRegistry, { Id = tonumber(id) or id, Tag = tostring(data.tag) })
                TagColors[data.tag] = normColor(data.color)
            else
                table.insert(RankRegistry, { Id = tonumber(id) or id, Tag = tostring(data) })
                TagColors[data] = "#FFFFFF"
            end
        end
    end
end
loadTags()

local function getTagForUser(userId)
    if not userId then return nil end
    for _, entry in ipairs(RankRegistry) do
        if tostring(entry.Id) == tostring(userId) then return entry.Tag end
    end
    return nil
end

