local function EstaEnWhitelist(jugador)
    return jugador
        and table.find(Whitelist, jugador.Name) ~= nil
end

local function FlingJugador(objetivo)
    if not objetivo or objetivo == JugadorLocal then
        return
    end

    -- Comprobar whitelist justo antes de atacar
    if EstaEnWhitelist(objetivo) then
        return
    end

    local Pelota = PelotasServidor:FindFirstChild("Soccer" .. JugadorLocal.Name)

    if not Pelota then
        Pelota = ObtenerPelota()
    end

    if not Pelota then
        return
    end

    -- Volver a comprobar por seguridad
    if EstaEnWhitelist(objetivo) then
        return
    end

    local personajeObjetivo = objetivo.Character
    if not personajeObjetivo then
        return
    end

    local raizObjetivo = personajeObjetivo:FindFirstChild("HumanoidRootPart")
    local humanoideObjetivo = personajeObjetivo:FindFirstChild("Humanoid")

    if not raizObjetivo or not humanoideObjetivo then
        return
    end

    Pelota.CanCollide = false
    Pelota.Massless = true
    Pelota.CustomPhysicalProperties = PhysicalProperties.new(0.0001, 0, 0)

    for _, v in ipairs(Pelota:GetChildren()) do
        if v:IsA("BodyVelocity") then
            v:Destroy()
        end
    end

    local velocidadCuerpo = Instance.new("BodyVelocity")
    velocidadCuerpo.Name = "FlingPower"
    velocidadCuerpo.Velocity = Vector3.new(9e8, 9e8, 9e8)
    velocidadCuerpo.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    velocidadCuerpo.P = 9e900
    velocidadCuerpo.Parent = Pelota

    local tiempoInicio = tick()

    repeat
        -- Comprobar whitelist durante el fling también
        if EstaEnWhitelist(objetivo) then
            break
        end

        if raizObjetivo.Velocity.Magnitude > 0 then
            local pos = raizObjetivo.Position + (raizObjetivo.Velocity / 1.5)
            Pelota.CFrame = CFrame.new(pos)
            Pelota.Orientation += Vector3.new(45, 60, 30)
        else
            for _, v in ipairs(personajeObjetivo:GetChildren()) do
                if v:IsA("BasePart") and v.CanCollide and not v.Anchored then
                    Pelota.CFrame = v.CFrame
                    task.wait(1 / 6000)
                end
            end
        end

        task.wait(1 / 6000)

    until raizObjetivo.Velocity.Magnitude > 1000
        or humanoideObjetivo.Health <= 0
        or not personajeObjetivo:IsDescendantOf(Mundo)
        or tick() - tiempoInicio > 8

    if velocidadCuerpo then
        velocidadCuerpo:Destroy()
    end
end

local function ObtenerJugadoresDisponibles()
    local disponibles = {}

    for _, jugador in ipairs(Jugadores:GetPlayers()) do
        if jugador ~= JugadorLocal and not EstaEnWhitelist(jugador) then
            table.insert(disponibles, jugador)
        end
    end

    return disponibles
end

