    if not colorValue then
        colorValue = Instance.new("Color3Value")
        colorValue.Name = "CurrentColor"
        colorValue.Value = Color3.fromRGB(255, 105, 180)
        colorValue.Parent = colorFolder
    end
    return colorValue
end

local colorValue = GetColorValue()

local function addOwnerLabel(character)
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head then return end
    if head:FindFirstChild("OwnerLabel") then 
        head:FindFirstChild("OwnerLabel"):Destroy()
    end

    local label = Instance.new("BillboardGui")
    label.Name = "OwnerLabel"
    label.Size = UDim2.new(0, 120, 0, 40)
    label.StudsOffset = Vector3.new(0, 3, 0)
    label.AlwaysOnTop = true
    label.Parent = head

    local text = Instance.new("TextLabel")
    text.Name = "OwnerText"
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundColor3 = ownerTagColor
    text.BackgroundTransparency = 0.5
    text.Text = "👉👈Jose❤👉👈"
    text.TextColor3 = ownerTagColor
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.TextStrokeTransparency = 0.3
    text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    text.Parent = label

    ownerTagLabel = text
    -- Aplicar color inicial de stroke
    updateOwnerTagColor(ownerTagColor)
end

local function removeOwnerLabel(character)
    if not character then return end
    local head = character:FindFirstChild("Head")
    if head then
        local existing = head:FindFirstChild("OwnerLabel")
        if existing then
            existing:Destroy()
        end
    end
    ownerTagLabel = nil
end

local function updateOwnerTagColor(color)
    ownerTagColor = color
    if ownerTagLabel then
        pcall(function()
            ownerTagLabel.TextColor3 = color
            -- Cambiar el stroke a un color complementario para mejor contraste
            ownerTagLabel.TextStrokeColor3 = Color3.fromRGB(
                math.max(0, 255 - color.R * 255),
                math.max(0, 255 - color.G * 255),
                math.max(0, 255 - color.B * 255)
            )
        end)
    end
end

local function watchOwner()
    local function processPlayer(plr)
        if plr.UserId ~= DEV_USER_ID then return end
        
        if plr.Character then
            addOwnerLabel(plr.Character)
        end
        
        plr.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            addOwnerLabel(char)
        end)
    end
    
    for _, plr in pairs(Players:GetPlayers()) do
        processPlayer(plr)
    end
    
    Players.PlayerAdded:Connect(processPlayer)
end

watchOwner()

