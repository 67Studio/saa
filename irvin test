local GITHUB_RAW_URL = "https://raw.githubusercontent.com/67Studio/irving-hub-bans/refs/heads/main/bans.json"

local function cargarBans()
    local exito, respuesta = pcall(function()
        return request({
            Url = GITHUB_RAW_URL,
            Method = "GET"
        })
    end)

    if not exito or type(respuesta) ~= "table" then
        return false
    end

    if respuesta.StatusCode ~= 200 then
        return false
    end

    local decodeSuccess, data = pcall(function()
        return HttpService:JSONDecode(respuesta.Body)
    end)

    if not decodeSuccess or type(data) ~= "table" then
        return false
    end

    bannedUsers = data.bannedUsers or {}

    return true
end

cargarBans()

