local NOMBRE_HERRAMIENTA = "Click Fling Ball"
local herramientaEquipada = false
local Jugadores = game:GetService("Players")
local AlmacenamientoRemoto = game:GetService("ReplicatedStorage")
local Mundo = game:GetService("Workspace")
local EntradaUsuario = game:GetService("UserInputService")
local Camara = Mundo.CurrentCamera
local JugadorLocal = Jugadores.LocalPlayer

local function CrearHerramienta()
    local mochila = JugadorLocal:WaitForChild("Backpack")
    if not mochila:FindFirstChild(NOMBRE_HERRAMIENTA) then
        local herramienta = Instance.new("Tool")
        herramienta.Name = NOMBRE_HERRAMIENTA
        herramienta.RequiresHandle = false
        herramienta.CanBeDropped = false
        herramienta.Equipped:Connect(function()
            herramientaEquipada = true
        end)
        herramienta.Unequipped:Connect(function()
            herramientaEquipada = false
        end)
        herramienta.Parent = mochila
    end
end
CrearHerramienta()

local function ObtenerPelota()
    local personaje = JugadorLocal.Character or JugadorLocal.CharacterAdded:Wait()
    local mochila = JugadorLocal:WaitForChild("Backpack")
    local PelotasServidor = Mundo:WaitForChild("WorkspaceCom"):WaitForChild("001_SoccerBalls")
    if not mochila:FindFirstChild("SoccerBall") and not personaje:FindFirstChild("SoccerBall") then
        pcall(function()
            AlmacenamientoRemoto:WaitForChild("RE"):FindFirstChild("1Too1l"):InvokeServer("PickingTools", "SoccerBall")
        end)
    end
    repeat task.wait() until mochila:FindFirstChild("SoccerBall") or personaje:FindFirstChild("SoccerBall")
    local pelotaHerramienta = mochila:FindFirstChild("SoccerBall")
    if pelotaHerramienta then
        pelotaHerramienta.Parent = personaje
    end
    repeat task.wait() until PelotasServidor:FindFirstChild("Soccer" .. JugadorLocal.Name)
    return PelotasServidor:FindFirstChild("Soccer" .. JugadorLocal.Name)
end

local function FlingBall(objetivo)
    if not objetivo or objetivo == JugadorLocal then return end
    local personaje = JugadorLocal.Character or JugadorLocal.CharacterAdded:Wait()
    local humanoide = personaje:WaitForChild("Humanoid")
    local PelotasServidor = Mundo:WaitForChild("WorkspaceCom"):WaitForChild("001_SoccerBalls")
    local Pelota = PelotasServidor:FindFirstChild("Soccer" .. JugadorLocal.Name) or ObtenerPelota()
    if not Pelota then return end
    Pelota.CanCollide = false
    Pelota.Massless = true
    Pelota.CustomPhysicalProperties = PhysicalProperties.new(0.0001, 0, 0)
    local personajeObjetivo = objetivo.Character
    if not personajeObjetivo then return end
    local raizObjetivo = personajeObjetivo:FindFirstChild("HumanoidRootPart")
    local humanoideObjetivo = personajeObjetivo:FindFirstChild("Humanoid")
    if not raizObjetivo or not humanoideObjetivo then return end
    for _, v in pairs(Pelota:GetChildren()) do
        if v:IsA("BodyVelocity") then v:Destroy() end
    end
    local velocidadCuerpo = Instance.new("BodyVelocity")
    velocidadCuerpo.Name = "FlingPower"
    velocidadCuerpo.Velocity = Vector3.new(9e8, 9e8, 9e8)
