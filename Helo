-- ===== PANTALLA DE CARGA CON TEXTO MÁS GRANDE =====
local function ShowLoadingScreen()
    local gui = Instance.new("ScreenGui")
    gui.Name = "Irvinglz1LoadingScreen"
    gui.Parent = game:GetService("CoreGui")
    gui.IgnoreGuiInset = true

    local bg = Instance.new("Frame", gui)
    bg.Size = UDim2.new(1,0,1,0)
    bg.BackgroundColor3 = Color3.fromRGB(10,10,10)

    local textLabel = Instance.new("TextLabel", bg)
    textLabel.Size = UDim2.new(1,0,0,150)  -- <--- MÁS ALTO
    textLabel.Position = UDim2.new(0,0,0.5,-75)  -- <--- AJUSTADO
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255,255,255)
    textLabel.TextStrokeTransparency = 0.5
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 80  -- <--- MUCHO MÁS GRANDE (antes 40)
    textLabel.TextTransparency = 1
    textLabel.Text = ""

    TweenService:Create(bg, TweenInfo.new(1), {
        BackgroundTransparency = 0
    }):Play()

    TweenService:Create(textLabel, TweenInfo.new(1), {
        TextTransparency = 0
    }):Play()

    local message = "Irving"
    for i = 1, #message do
        textLabel.Text = string.sub(message, 1, i)
        task.wait(0.1)
    end

    task.wait(2)

    local fadeOut = TweenService:Create(bg, TweenInfo.new(1.5), {
        BackgroundTransparency = 1
    })

    local textFade = TweenService:Create(textLabel, TweenInfo.new(1.5), {
        TextTransparency = 1
    })

    fadeOut:Play()
    textFade:Play()

    fadeOut.Completed:Wait()
    gui:Destroy()
end

ShowLoadingScreen()

