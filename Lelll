-- 👑 Función para crear la etiqueta "Owner" (sin parpadeo)
local function addOwnerLabel(character)
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head then return end
    if head:FindFirstChild("OwnerLabel") then return end

    local label = Instance.new("BillboardGui")
    label.Name = "OwnerLabel"
    label.Size = UDim2.new(0, 100, 0, 40)
    label.StudsOffset = Vector3.new(0, 3, 0)
    label.AlwaysOnTop = true
    label.Parent = head

    -- Texto sin fondo
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1  -- Sin fondo
    text.Text = "👑 Owner"
    text.TextColor3 = Color3.fromRGB(255, 215, 0)  -- Dorado
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.TextStrokeTransparency = 0.3  -- Borde sutil para que se vea mejor
    text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    text.Parent = label
end

-- 🔄 Función para actualizar
local function updateLabel(character)
    if not character then return end
    
    if getgenv().CROWN_ENABLED then
        addOwnerLabel(character)
    else
        local head = character:FindFirstChild("Head")
        if head then
            local existing = head:FindFirstChild("OwnerLabel")
            if existing then
                existing:Destroy()
            end
        end
    end
end

-- 👀 Vigilar al owner
local function watchOwner(plr)
    if plr.Name ~= DEV_USER then return end

    task.spawn(function()
        while plr.Parent do
            local char = plr.Character
            if char then
                updateLabel(char)
            end
            task.wait(1)
        end
    end)
end

