--===[[ COMANDO !tp - SOLO a los que tienen el script ]]===--
local function TeleportScriptPlayersToOwner()
    local owner = player
    local ownerChar = owner.Character
    if not ownerChar then
        Rayfield:Notify({
            Title = "❌ Error",
            Content = "No tienes personaje activo.",
            Duration = 3,
            Image = 4483362458,
        })
        return
    end

    local rootPart = ownerChar:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        Rayfield:Notify({
            Title = "❌ Error",
            Content = "No se encontró HumanoidRootPart.",
            Duration = 3,
            Image = 4483362458,
        })
        return
    end

    local targetPosition = rootPart.Position
    local count = 0

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= owner then
            local hasScript = false
            pcall(function()
                if plr.PlayerGui:FindFirstChild("Irvinglz1_Detector") then
                    hasScript = true
                end
            end)
            
            if hasScript then
                local char = plr.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = CFrame.new(targetPosition + Vector3.new(0, 5, 0))
                        count = count + 1
                    end
                end
            end
        end
    end

    Rayfield:Notify({
        Title = "✅ Teletransporte completo",
        Content = "Se teletransportaron " .. count .. " jugadores con el script.",
        Duration = 3,
        Image = 4483362458,
    })
end

