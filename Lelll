local function EstaEnWhitelist(jugador)
    return table.find(Whitelist, jugador.Name) ~= nil
end

local function FlingJugador(objetivo)
    if not objetivo or objetivo == JugadorLocal or EstaEnWhitelist(objetivo) then return end
    local Pelota = PelotasServidor:FindFirstChild("Soccer" .. JugadorLocal.Name) or ObtenerPelota()
    if not Pelota then return end
    local personajeObjetivo = objetivo.Character
    if not personajeObjetivo then return end
    local raizObjetivo = personajeObjetivo:FindFirstChild("HumanoidRootPart")
    local humanoideObjetivo = personajeObjetivo:FindFirstChild("Humanoid")
    if not raizObjetivo or not humanoideObjetivo then return end
    Pelota.CanCollide = false
    Pelota.Massless = true
    Pelota.CustomPhysicalProperties = PhysicalProperties.new(0.0001, 0, 0)
    for _, v in pairs(Pelota:GetChildren()) do
        if v:IsA("BodyVelocity") then v:Destroy() end
    end
    local velocidadCuerpo = Instance.new("BodyVelocity")
    velocidadCuerpo.Name = "FlingPower"
    velocidadCuerpo.Velocity = Vector3.new(9e8, 9e8, 9e8)
    velocidadCuerpo.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    velocidadCuerpo.P = 9e900
    velocidadCuerpo.Parent = Pelota
    local tiempoInicio = tick()
    repeat
        if raizObjetivo.Velocity.Magnitude > 0 then
            local pos = raizObjetivo.Position + (raizObjetivo.Velocity / 1.5)
            Pelota.CFrame = CFrame.new(pos)
            Pelota.Orientation += Vector3.new(45, 60, 30)
        else
            for _, v in pairs(personajeObjetivo:GetChildren()) do
                if v:IsA("BasePart") and v.CanCollide and not v.Anchored then
                    Pelota.CFrame = v.CFrame
                    task.wait(1/6000)
                end
            end
        end
        task.wait(1/6000)
    until raizObjetivo.Velocity.Magnitude > 1000 or humanoideObjetivo.Health <= 0 or not personajeObjetivo:IsDescendantOf(Mundo) or tick() - tiempoInicio > 8
end

local function ObtenerJugadorDisponible()
    for _, jugador in pairs(Jugadores:GetPlayers()) do
        if jugador ~= JugadorLocal and not EstaEnWhitelist(jugador) then
            return jugador
        end
    end
    return nil
end

local function FlingTodos()
    local jugador = ObtenerJugadorDisponible()
    if jugador then
        task.spawn(function() FlingJugador(jugador) end)
    end
end

