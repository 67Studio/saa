-- ===== FUNCIONES DEL CHAT =====

-- Agregar mensaje
local function AddMessage(sender, msg, isOwnerMsg)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 22)
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextWrapped = true
    
    if isOwnerMsg then
        label.Text = "👑 " .. sender .. ": " .. msg
        label.TextColor3 = Color3.fromRGB(255, 215, 0)
    else
        label.Text = "👤 " .. sender .. ": " .. msg
        label.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
    
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.Parent = scroll
    
    -- Limitar a 30 mensajes
    local children = scroll:GetChildren()
    local count = 0
    for _, child in pairs(children) do
        if child:IsA("TextLabel") then
            count = count + 1
        end
    end
    if count > 30 then
        for _, child in pairs(children) do
            if child:IsA("TextLabel") then
                child:Destroy()
                break
            end
        end
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, count * 26 + 10)
    scroll.CanvasPosition = Vector2.new(0, scroll.CanvasSize.Y.Offset)
end

-- Enviar mensaje (solo owner)
local function SendMessage(msg)
    if msg == "" then return end
    local displayName = player.DisplayName or player.Name
    local message = "[👑 " .. displayName .. "]: " .. msg
    
    -- Enviar al chat de Roblox
    pcall(function()
        TextChatService.TextChannels.RBXGeneral:SendAsync(message)
    end)
    
    -- Mostrar en el chat local
    AddMessage("👑 " .. displayName, msg, true)
end

-- Procesar mensajes entrantes (solo del owner)
local function ProcessMessage(msg)
    if not msg then return end
    local senderName = msg:match("%[👑 (.-)%]:")
    if senderName then
        local content = msg:gsub("%[👑 .-%]: ", "")
        AddMessage("👑 " .. senderName, content, true)
    end
end

-- ===== INPUT DEL CHAT =====
local chatInput = Instance.new("TextBox")
chatInput.Size = UDim2.new(1, -10, 0, 30)
chatInput.Position = UDim2.new(0, 5, 1, -35)
chatInput.TextColor3 = Color3.fromRGB(255, 255, 255)
chatInput.Font = Enum.Font.Gotham
chatInput.TextSize = 14
chatInput.ClearTextOnFocus = false
chatInput.Parent = chatFrame
Instance.new("UICorner", chatInput).CornerRadius = UDim.new(0, 8)

chatInput.PlaceholderText = "✏️ Escribe un mensaje..."
chatInput.BackgroundColor3 = Color3.fromRGB(30, 50, 40)

-- Enviar al presionar Enter
chatInput.FocusLost:Connect(function(enterPressed)
    if enterPressed and chatInput.Text ~= "" then
        SendMessage(chatInput.Text)
        chatInput.Text = ""
    end
end)

-- También con la tecla Enter
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.Return and chatInput:IsFocused() then
        if chatInput.Text ~= "" then
            SendMessage(chatInput.Text)
            chatInput.Text = ""
        end
    end
end)

-- ===== ESCUCHAR MENSAJES =====
task.spawn(function()
    TextChatService.MessageReceived:Connect(function(messageData)
        if messageData.TextSource and messageData.Text then
            local sender = messageData.TextSource.Name
            if sender ~= player.Name then
                ProcessMessage(messageData.Text)
            end
        end
    end)
end)

-- ===== MOVER EL CHAT =====
local dragToggle, dragStart, startPos

chatFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragToggle = true
        dragStart = input.Position
        startPos = chatFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragToggle and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        chatFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragToggle = false
    end
end)

