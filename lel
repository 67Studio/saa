local SONGS_URL = "https://raw.githubusercontent.com/67Studio/ELFB/refs/heads/main/UwU89"
local BLACKLIST_NAMES = {["67 aura"] = true, ["aura"] = true}

local function fetchSongs()
    local ok, raw = pcall(function() return game:HttpGet(SONGS_URL) end)
    if not ok or type(raw) ~= "string" or raw == "" then return nil end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(data) ~= "table" then return nil end
    local list = data.songs or data
    local out, seenIds, seenNames = {}, {}, {}
    local MAX_NAME = 120
    for _, s in ipairs(list) do
        local id = s.id or s.ID or s.assetId
        local n = s.name or s.Name or s.title
        local c = s.category or s.Category or "Otro"
        if id and n then
            id = tostring(id)
            n = tostring(n):gsub("^%s+", ""):gsub("%s+$", "")
            c = tostring(c)
            local validId = id:match("^%d+$") ~= nil
            local validName = #n >= 2 and #n <= MAX_NAME
            if validId and validName and not seenIds[id] and not seenNames[n:lower()] and not BLACKLIST_NAMES[n:lower()] then
                seenIds[id] = true
                seenNames[n:lower()] = true
                table.insert(out, {id = id, name = n, category = c})
            end
        end
    end
    return #out > 0 and out or nil
end

