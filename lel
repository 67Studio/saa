PropsTb:AddToggle({
    Name = "Orbit Prop",
    Default = false,
    Callback = function(Value)
        if propsOrbitConnection then propsOrbitConnection:Disconnect(); propsOrbitConnection = nil end
        if not Value then return end
        local speed = 2
        local radius = 6
        local heightOffset = -3
        local angle = 0
        propsOrbitConnection = RunService.Heartbeat:Connect(function(delta)
            local char = player.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            local list = propsGetMyProps()
            if not list or #list == 0 then return end
            angle += delta * speed
            local spacing = (math.pi * 2) / #list
            for i, prop in ipairs(list) do
                if prop and prop.Parent then
                    local currentAngle = angle + (i * spacing)
                    local x = math.cos(currentAngle) * radius
                    local z = math.sin(currentAngle) * radius
                    local worldPos = root.Position + Vector3.new(x, heightOffset, z)
                    local lookAt = CFrame.lookAt(worldPos, root.Position)
                    local remote = prop:FindFirstChild("SetCurrentCFrame")
                    if remote then
                        pcall(function() remote:InvokeServer(lookAt) end)
                    end
                end
            end
        end)
    end
})

