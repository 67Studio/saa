local function hkIniciarMonitor()
    if hkMonitorThread then task.cancel(hkMonitorThread) hkMonitorThread = nil end
    if not hkTarget then return end
    hkMonitorThread = task.spawn(function()
        while hkRunning and hkTarget and hkTarget.Parent do
            if hkEstaSentado(hkTarget) and hkHasHouse then
                hkTeletransportarACasa(hkTarget)
                if hkFollowing then
                    hkFollowing = false
                    if hkLoopThread then task.cancel(hkLoopThread) hkLoopThread = nil end
                end
                task.wait(0.3)
            end
            task.wait(0.3)
        end
        hkMonitorThread = nil
    end)
end

local function hkIniciarTodo()
    if hkRunning then
        notify({Title="⚠️ Ya corriendo", Duration=2, Warning=true})
        return
    end
    if not hkTarget then
        notify({Title="❌ Error", Text="Selecciona un jugador primero", Duration=3, Danger=true})
        return
    end
    hkRunning = true
    hkFollowing = true
    if hkLoopThread then task.cancel(hkLoopThread) hkLoopThread = nil end
    if hkMonitorThread then task.cancel(hkMonitorThread) hkMonitorThread = nil end
    notify({Title="🏠 Iniciando Casa Ban", Duration=2})

    task.spawn(function()
        local existe, info = hkVerificarCasa()
        if existe then
            hkHasHouse = true
            hkHouseData = info
        else
            if not hkComprarCasa() then
                hkRunning = false
                hkFollowing = false
                notify({Title="❌ Error", Text="No se pudo comprar casa", Duration=3, Danger=true})
                return
            end
        end

        task.wait(0.2)
        local conos = hkTeletransportarYColocar()
        if not conos or #conos == 0 then
            notify({Title="❌ Error", Text="No se confirmaron los conos", Duration=3, Danger=true})
            warn("[CasaBan] No se confirmaron los conos, abortando.")
            hkRunning = false
            hkFollowing = false
            return
        end
        hkMyCones = conos

        hkLoopThread = task.spawn(function()
            while hkFollowing and hkRunning do
                if not hkTarget or not hkTarget.Character then break end
                if hkEstaSentado(hkTarget) then break end
                local raiz = hkTarget.Character:FindFirstChild("HumanoidRootPart")
                if raiz then hkMoverConos(hkMyCones, raiz.Position) end
                task.wait(0.05)
            end
            hkFollowing = false
            hkLoopThread = nil
        end)

        hkIniciarMonitor()
        notify({Title="🏠 Casa Ban activo", Duration=3, Success=true})
    end)
end

local function hkDetenerTodo()
    hkRunning = false
    hkFollowing = false
    hkDesactivarAntiSentarse()
    if hkLoopThread then task.cancel(hkLoopThread) hkLoopThread = nil end
    if hkMonitorThread then task.cancel(hkMonitorThread) hkMonitorThread = nil end
    hkMyCones = {}
    notify({Title="⏹️ Casa Ban parado", Duration=2})
end

