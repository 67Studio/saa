AntiTb:AddToggle({
    Name = "Anti-Lag",
    Default = false,
    Callback = function(s)
        if not s then return end
        local lock, skip = {}, nil
        local function tools(plr)
            local list, box = {}, {}
            if plr.Character then box[#box+1] = plr.Character end
            local bp = plr:FindFirstChildOfClass("Backpack")
            if bp then box[#box+1] = bp end
            local sg = plr:FindFirstChild("StarterGear")
            if sg then box[#box+1] = sg end
            for _, c in ipairs(box) do
                for _, t in ipairs(c:GetChildren()) do
                    if t:IsA("Tool") then list[#list+1] = t end
                end
            end
            return list
        end
        local function clean(plr)
            if plr == skip or lock[plr] then return end
            lock[plr] = true
            local t = tools(plr)
            for i = 2, #t do pcall(function() t[i]:Destroy() end) end
            lock[plr] = false
        end
        local function hook(plr)
            skip = skip or plr
            task.defer(clean, plr)
            local function setup(ch)
                task.delay(0.5, function() clean(plr) end)
                ch.ChildAdded:Connect(function(c)
                    if c:IsA("Tool") then task.delay(0.1, function() clean(plr) end) end
                end)
            end
            if plr.Character then setup(plr.Character) end
            plr.CharacterAdded:Connect(setup)
            local bp = plr:WaitForChild("Backpack", 10)
            if bp then
                bp.ChildAdded:Connect(function(c)
                    if c:IsA("Tool") then task.delay(0.1, function() clean(plr) end) end
                end)
            end
            local sg = plr:FindFirstChild("StarterGear") or plr:WaitForChild("StarterGear", 10)
            if sg then
                sg.ChildAdded:Connect(function(c)
                    if c:IsA("Tool") then task.delay(0.1, function() clean(plr) end) end
                end)
            end
        end
        antiPlayers.PlayerAdded:Connect(hook)
        for _, plr in ipairs(antiPlayers:GetPlayers()) do hook(plr) end
        task.spawn(function()
            while s do
                for _, plr in ipairs(antiPlayers:GetPlayers()) do clean(plr) end
                task.wait(2)
            end
        end)
    end
})

