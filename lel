    for _, hijo in pairs(miCasa:GetDescendants()) do
        if hijo:IsA("NumberValue") and hijo.Name == "Number" then
            info.Numero = hijo.Value break
        end
    end
    local spawn = miCasa:FindFirstChild("HouseSpawnPosition")
    if spawn and spawn:IsA("BasePart") then
        info.Posicion = spawn.Position
        info.CFrame = spawn.CFrame
