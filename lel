local function calcularTiempoRestante(expires_at)
    if not expires_at then return "Permanente" end
    local ahora = os.time()
    local expiracion = os.time({
        year = tonumber(string.sub(expires_at, 1, 4)),
        month = tonumber(string.sub(expires_at, 6, 7)),
        day = tonumber(string.sub(expires_at, 9, 10)),
        hour = tonumber(string.sub(expires_at, 12, 13)),
        min = tonumber(string.sub(expires_at, 15, 16)),
        sec = tonumber(string.sub(expires_at, 18, 19))
    })
    local dif = expiracion - ahora
    if dif <= 0 then return "0 segundos" end
    local dias = math.floor(dif / 86400)
    local horas = math.floor((dif % 86400) / 3600)
    local min = math.floor((dif % 3600) / 60)
    local sec = math.floor(dif % 60)
    local r = {}
    if dias > 0 then table.insert(r, dias .. "d") end
    if horas > 0 then table.insert(r, horas .. "h") end
    if min > 0 then table.insert(r, min .. "m") end
    if sec > 0 or #r == 0 then table.insert(r, sec .. "s") end
    return table.concat(r, " ")
end

local function partirTexto(texto, maxCaracteres)
    if not texto or texto == "" then return {"No especificado"} end
    local lineas, lineaActual = {}, ""
    for palabra in texto:gmatch("%S+") do
        if #lineaActual + #palabra + 1 <= maxCaracteres then
            lineaActual = (lineaActual == "" and palabra) or (lineaActual .. " " .. palabra)
        else
            table.insert(lineas, lineaActual)
            lineaActual = palabra
        end
    end
    if lineaActual ~= "" then table.insert(lineas, lineaActual) end
    return lineas
end

