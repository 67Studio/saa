local function hkComprarCasa()
    if hkBuyingHouse then return false end
    hkBuyingHouse = true
    local personaje = hkMe.Character or hkMe.CharacterAdded:Wait()
    local raiz = personaje:FindFirstChild("HumanoidRootPart")
    local lotes = hkWorkspace:FindFirstChild("001_Lots")
    if not lotes or not raiz then hkBuyingHouse = false return false end
    if lotes:FindFirstChild(hkMe.Name .. "House") then hkBuyingHouse = false return true end

    local disponibles = {}
    for _, lote in pairs(lotes:GetChildren()) do
        if lote.Name == "For Sale" then
            for _, numero in pairs(lote:GetDescendants()) do
                if numero:IsA("NumberValue") and numero.Name == "Number" and numero.Value < 25 and numero.Value > 10 then
                    table.insert(disponibles, {Lote = lote, Numero = numero.Value}) break
                end
            end
        end
    end
    if #disponibles == 0 then hkBuyingHouse = false return false end

    local seleccionado = disponibles[math.random(1, #disponibles)]
    local loteElegido, numeroCasa = seleccionado.Lote, seleccionado.Numero

    local detectorCompra = loteElegido:FindFirstChild("BuyHouse")
    if detectorCompra and detectorCompra:IsA("BasePart") then
        raiz.CFrame = detectorCompra.CFrame + Vector3.new(0, -6, 0)
        task.wait(0.3)
        local click = detectorCompra:FindFirstChild("ClickDetector")
        if click then pcall(function() fireclickdetector(click) end) end
    end
    task.wait(0.3)

    local remotos = hkRS:FindFirstChild("Remotes")
    if remotos then
        local construir = remotos:FindFirstChild("Lot:BuildProperty")
        if construir then pcall(function() construir:InvokeServer(numeroCasa, "102_House") end) end
    end
    task.wait(0.5)

    local casaPrevia = lotes:FindFirstChild(hkMe.Name .. "House")
    if not casaPrevia then hkBuyingHouse = false return false end

    local valorNumero
    for _, x in pairs(casaPrevia:GetDescendants()) do
        if x.Name == "Number" and x:IsA("NumberValue") then valorNumero = x break end
    end
    if not valorNumero then hkBuyingHouse = false return false end
    task.wait(0.3)

    local re = hkRS:FindFirstChild("RE")
    if re then
        local obtenerCasa = re:FindFirstChild("1Gettin1gHous1e")
        if obtenerCasa then
            pcall(function() obtenerCasa:InvokeServer("PickingCustomHouse", "049_House", valorNumero.Value) end)
        end
    end
    hkBuyingHouse = false

    local exito, info = hkVerificarCasa()
    if exito then hkHasHouse = true hkHouseData = info return true end
    return false
end

