local AntiSitEnabled = false

local function ClearAntiSit()
    AntiSitEnabled = false
    for i = #AntiSitConnections, 1, -1 do
        local conn = AntiSitConnections[i]
        if conn and typeof(conn) == "RBXScriptConnection" then
            pcall(function() conn:Disconnect() end)
        end
        AntiSitConnections[i] = nil
    end
    AntiSitConnections = {}
    local c = player.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then
            h:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            h:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

local function EnableAntiSit()
    ClearAntiSit()
    AntiSitEnabled = true
    local function Apply(c)
        local h = c:WaitForChild("Humanoid", 5)
        if not h then return end
        h:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        local conn = h.StateChanged:Connect(function(_, st)
            if AntiSitEnabled and st == Enum.HumanoidStateType.Seated then
                h:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)
        table.insert(AntiSitConnections, conn)
    end
    if player.Character then Apply(player.Character) end
    table.insert(AntiSitConnections, player.CharacterAdded:Connect(function(c)
        if AntiSitEnabled then Apply(c) end
    end))
    table.insert(AntiSitConnections, RunService.Heartbeat:Connect(function()
        if not AntiSitEnabled then return end
        local c = player.Character
        if not c then return end
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end
    end))
end

local function SetAntiSit(state)
    if state then EnableAntiSit() else ClearAntiSit() end
end

