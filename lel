local function hasFS()
    return (writefile and readfile and isfile) ~= nil
end

local function loadFavs()
    getgenv().KAZE_FAVORITES = {}
    if not hasFS() then return false end
    local ok, ex = pcall(isfile, FAV_FILE)
    if not ok or not ex then return false end
    local rok, c = pcall(readfile, FAV_FILE)
    if not rok or not c or c == "" then return false end
    local dok, d = pcall(function() return HttpService:JSONDecode(c) end)
    if not dok or type(d) ~= "table" then return false end
    getgenv().KAZE_FAVORITES = d
    return true
end

local function saveFavs()
    if not hasFS() then return false end
    local eok, enc = pcall(function() return HttpService:JSONEncode(getgenv().KAZE_FAVORITES) end)
    if not eok then return false end
    return pcall(writefile, FAV_FILE, enc)
end

function AddFavorite(n, id)
    if not n or not id then return false end
    id = tostring(id)
    for _, f in ipairs(getgenv().KAZE_FAVORITES) do
        if tostring(f.id) == id then return false end
    end
    table.insert(getgenv().KAZE_FAVORITES, {name = n, id = id, added_at = os.time()})
    saveFavs()
    return true
end

function RemoveFavorite(id)
    id = tostring(id)
    for i, f in ipairs(getgenv().KAZE_FAVORITES) do
        if tostring(f.id) == id then
            table.remove(getgenv().KAZE_FAVORITES, i)
            saveFavs()
            return true
        end
    end
    return false
end

