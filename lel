-- NOTIFY VISIBLE + SILENCIOSO + ANTI-SPAM
-- ═══════════════════════════════════════════════════════
local _activeNotify = nil
local _lastNotifyKey = nil
local _lastNotifyTime = 0

local function notify(cfg)
    local key = tostring(cfg.Title or "") .. "|" .. tostring(cfg.Text or "")
    local now = tick()
    if key == _lastNotifyKey and (now - _lastNotifyTime) < 2 then
        return
    end
    _lastNotifyKey = key
    _lastNotifyTime = now

    if _activeNotify then
        pcall(function()
            if _activeNotify.Parent then
                _activeNotify:Destroy()
            end
        end)
        _activeNotify = nil
        task.wait()
    end

    if Nova and type(Nova.Notify) == "function" then
        local before = {}
        for _, obj in ipairs(SoundService:GetChildren()) do
            if obj:IsA("Sound") then before[obj] = true end
        end

        local ok, result = pcall(function()
            return Nova:Notify(cfg)
        end)

        if ok and result then
            _activeNotify = result
            task.spawn(function()
                local startTime = tick()
                while tick() - startTime < 1.5 do
                    pcall(function()
                        if result and result.Parent then
                            for _, d in ipairs(result:GetDescendants()) do
                                if d:IsA("Sound") then
                                    d.Volume = 0
                                    pcall(function() d:Stop() end)
                                    pcall(function() d:Destroy() end)
                                end
                            end
                        end
                    end)
                    pcall(function()
                        for _, obj in ipairs(SoundService:GetChildren()) do
                            if obj:IsA("Sound") and not before[obj] and obj.Playing then
                                obj.Volume = 0
                                pcall(function() obj:Stop() end)
                                pcall(function() obj:Destroy() end)
                                before[obj] = nil
                            end
                        end
                    end)
                    task.wait(0.03)
                end
            end)
        end
    end
end

