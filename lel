local function hkAplicarAntiSentarse(personaje)
    if not personaje then return end
    local humanoide = personaje:FindFirstChildOfClass("Humanoid")
    local raiz = personaje:FindFirstChild("HumanoidRootPart")
    if not humanoide or not raiz then return end
    for _, conexion in pairs(hkConexionesAntiSentarse) do
        pcall(function() conexion:Disconnect() end)
    end
    table.clear(hkConexionesAntiSentarse)
    pcall(function() humanoide:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end)
    hkConexionesAntiSentarse[#hkConexionesAntiSentarse+1] = humanoide.StateChanged:Connect(function(_, nuevo)
        if hkAntiSentarse and nuevo == Enum.HumanoidStateType.Seated then
            humanoide.Sit = false
            humanoide:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
    hkConexionesAntiSentarse[#hkConexionesAntiSentarse+1] = hkRunService.Heartbeat:Connect(function()
        if not hkAntiSentarse then return end
        if not personaje or not personaje.Parent then return end
        pcall(function()
