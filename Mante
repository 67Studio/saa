-- Función mejorada para detectar el ejecutor
local function detectExecutor()
    local executorName = "Desconocido"
    
    -- Método 1: identifyexecutor() (más preciso)
    pcall(function()
        if identifyexecutor then
            local name, version = identifyexecutor()
            if name then
                executorName = tostring(name)
                if version then
                    executorName = executorName .. ' - ' .. tostring(version)
                end
                return executorName
            end
        end
    end)
    
    -- Método 2: Variables globales de ejecutores comunes
    pcall(function()
        if syn and syn.version then
            executorName = "Synapse X - " .. syn.version
        elseif krnl and krnl.version then
            executorName = "Krnl - " .. krnl.version
        elseif script and script.Name and script.Name == "Solara" then
            executorName = "Solara"
        elseif _G and _G.ExecutionIdentity then
            executorName = _G.ExecutionIdentity
        elseif getexecutorname then
            local name = getexecutorname()
            if name and name ~= "" then
                executorName = name
            end
        end
    end)
    
    return executorName
end

