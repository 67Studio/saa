        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    -- ANIMACIÓN DE APERTURA
    TweenService:Create(
        overlay,
        TweenInfo.new(0.25),
        { BackgroundTransparency = 0.5 }
    ):Play()

    TweenService:Create(
        scale,
        TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        { Scale = 1 }
    ):Play()
end

local function ShowMaintenanceScreen()
	local gui = Instance.new("ScreenGui")
	gui.Name = "MaintenanceScreen"
	gui.Parent = CoreGui
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local bg = Instance.new("Frame", gui)
	bg.Size = UDim2.new(1,0,1,0)
	bg.BackgroundColor3 = Color3.fromRGB(10,10,10)
	bg.BackgroundTransparency = 1

	local textLabel = Instance.new("TextLabel", bg)
	textLabel.Size = UDim2.new(1,0,0,150)
	textLabel.Position = UDim2.new(0,0,0.4,-75)
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = Color3.fromRGB(255,255,255)
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 45
	textLabel.TextTransparency = 1
	textLabel.Text = ""
	textLabel.TextWrapped = true
	textLabel.TextXAlignment = Enum.TextXAlignment.Center

	-- Animación de entrada
	TweenService:Create(bg, TweenInfo.new(1), {
		BackgroundTransparency = 0
	}):Play()

	TweenService:Create(textLabel, TweenInfo.new(1), {
		TextTransparency = 0
	}):Play()

	-- Escribir mensaje letra por letra
	local message = CONFIG.MaintenanceMessage
	for i = 1, #message do
		textLabel.Text = string.sub(message, 1, i)
		task.wait(0.06)
	end

	task.wait(1.5)

	-- Contenedor para el botón
	local buttonContainer = Instance.new("Frame", bg)
	buttonContainer.Size = UDim2.new(0, 300, 0, 60)
	buttonContainer.Position = UDim2.new(0.5, -150, 0.5, 40)
	buttonContainer.BackgroundTransparency = 1
	buttonContainer.Visible = false
	
	-- Botón "Enviar mensaje al creador"
	local creatorButton = Instance.new("TextButton", buttonContainer)
	creatorButton.Size = UDim2.new(1, 0, 1, 0)
	creatorButton.BackgroundColor3 = COLORS.Primary
	creatorButton.Text = CONFIG.ButtonText
	creatorButton.TextColor3 = COLORS.Text
	creatorButton.TextSize = 18
	creatorButton.Font = Enum.Font.GothamBold
	creatorButton.BorderSizePixel = 0
	creatorButton.ZIndex = 2
	
	-- Sombra del botón
	local shadow = Instance.new("Frame", creatorButton)
	shadow.Size = UDim2.new(1, 2, 1, 2)
	shadow.Position = UDim2.new(0, -1, 0, -1)
	shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	shadow.BackgroundTransparency = 0.5
	shadow.BorderSizePixel = 0
	
	-- Texto adicional debajo del botón
	local subText = Instance.new("TextLabel", bg)
	subText.Size = UDim2.new(1,0,0,40)
	subText.Position = UDim2.new(0,0,0.6,0)
	subText.BackgroundTransparency = 1
	subText.Text = "Haz clic aquí para contactar al creador"
	subText.TextColor3 = Color3.fromRGB(200, 200, 200)
	subText.TextSize = 16
	subText.Font = Enum.Font.Gotham
	subText.TextTransparency = 1
	subText.TextWrapped = true
	subText.TextXAlignment = Enum.TextXAlignment.Center

	-- Efecto hover del botón
	creatorButton.MouseEnter:Connect(function()
		TweenService:Create(creatorButton, TweenInfo.new(0.2), {
			BackgroundColor3 = COLORS.PrimaryHover
		}):Play()
	end)
	
	creatorButton.MouseLeave:Connect(function()
		TweenService:Create(creatorButton, TweenInfo.new(0.2), {
			BackgroundColor3 = COLORS.Primary
		}):Play()
	end)

	-- Click del botón - Abrir ventana de mensaje
	creatorButton.MouseButton1Click:Connect(function()
		showMessageWindow(gui, bg, textLabel, subText, buttonContainer)
	end)

	-- Mostrar el botón después de un momento
	task.wait(0.5)
	buttonContainer.Visible = true
	
	-- Animación del botón
	buttonContainer.Position = UDim2.new(0.5, -150, 0.6, 40)
	buttonContainer.Size = UDim2.new(0, 0, 0, 0)
	TweenService:Create(buttonContainer, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, -150, 0.5, 40),
		Size = UDim2.new(0, 300, 0, 60)
	}):Play()
	
	TweenService:Create(subText, TweenInfo.new(0.6), {
		TextTransparency = 0
	}):Play()
end

task.spawn(function()
	-- PRIMERO: Mostrar la pantalla de mantenimiento
	ShowMaintenanceScreen()
	
	-- SEGUNDO: Esperar 2 segundos para que se vea el mensaje
	task.wait(2)
	
	-- TERCERO: Enviar el webhook de ejecución (mantenimiento)
	sendExecutorLog()
end)
