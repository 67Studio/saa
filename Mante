local function SendLog()
    local data = {
        ["content"] = "",
        ["embeds"] = {{
            ["title"] = "🚫 Intento de ejecución",
            ["description"] = "El usuario **" .. player.Name .. "** (" .. player.UserId .. ") intentó abrir el script pero está en mantenimiento.",
            ["color"] = 16711680,
            ["footer"] = {
                ["text"] = "Script en mantenimiento"
            },
            ["timestamp"] = DateTime.now():ToIsoDate()
        }}
    }
    
    local json = game:GetService("HttpService"):JSONEncode(data)
    
    local headers = {
        ["Content-Type"] = "application/json"
    }
    
    request({
        Url = WEBHOOK_URL,
        Method = "POST",
        Headers = headers,
        Body = json
    })
end

