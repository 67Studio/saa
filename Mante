local TweenService = game:GetService("TweenService")
local DISCORD_INVITE = "https://discord.gg/CDNRhNguz"

local function ShowLoadingScreen()
    local gui = Instance.new("ScreenGui")
    gui.Name = "LoadingScreen"
    gui.Parent = game:GetService("CoreGui")
    gui.IgnoreGuiInset = true

    local bg = Instance.new("Frame", gui)
    bg.Size = UDim2.new(1,0,1,0)
    bg.BackgroundColor3 = Color3.fromRGB(10,10,10)

    local textLabel = Instance.new("TextLabel", bg)
    textLabel.Size = UDim2.new(1,0,0,150)
    textLabel.Position = UDim2.new(0,0,0.5,-75)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255,255,255)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 45
    textLabel.TextTransparency = 1
    textLabel.Text = ""
    textLabel.TextWrapped = true
    textLabel.TextXAlignment = Enum.TextXAlignment.Center

    TweenService:Create(bg, TweenInfo.new(1), {
        BackgroundTransparency = 0
    }):Play()

    TweenService:Create(textLabel, TweenInfo.new(1), {
        TextTransparency = 0
    }):Play()

    local message = "Script en mantenimiento\nÚnete al Discord:\n" .. DISCORD_INVITE
    for i = 1, #message do
        textLabel.Text = string.sub(message, 1, i)
        task.wait(0.06)
    end

    -- Esperar 10 segundos antes de desaparecer
    task.wait(10)

    local fadeOut = TweenService:Create(bg, TweenInfo.new(1.5), {
        BackgroundTransparency = 1
    })

    local textFade = TweenService:Create(textLabel, TweenInfo.new(1.5), {
        TextTransparency = 1
    })

    fadeOut:Play()
    textFade:Play()

    fadeOut.Completed:Wait()
    gui:Destroy()
end

ShowLoadingScreen()
