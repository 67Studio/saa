local elapsed = 0

local renderConnection

renderConnection =
	RunService.RenderStepped:Connect(
		function(dt)

			if not activo then
				return
			end

			if not humCorredor.Parent
				or humCorredor.Health <= 0 then

				activo = false
				return

			end

			elapsed += dt

			local t =
				math.clamp(
					elapsed / DURACION,
					0,
					1
				)

			--========================================
			-- CORRER
			--========================================

			humCorredor:Move(
				direction,
				false
			)

			--========================================
			-- PLANOS ANIME
			--========================================

			local phase =
				t * 4

			local cameraPosition
			local lookTarget

			------------------------------------------
			-- PLANO 1: TRASERO
			------------------------------------------

			if phase < 1 then

				local a = phase

				cameraPosition =
					rootCorredor.Position
					- direction
					* (
						15
						- a * 4
					)

					+ Vector3.new(
						0,
						5,
						0
					)

				lookTarget =
					rootCorredor.Position
					+ Vector3.new(
						0,
						2.2,
						0
					)

			------------------------------------------
			-- PLANO 2: LATERAL
			------------------------------------------

			elseif phase < 2 then

				local a =
					phase - 1

				cameraPosition =
					rootCorredor.Position

					+ rootCorredor.CFrame.RightVector
					* (
						14
						- a * 5
					)

					- direction * 5

					+ Vector3.new(
						0,
						4,
						0
					)

				lookTarget =
					rootCorredor.Position
					+ direction * 5
					+ Vector3.new(
						0,
						2,
						0
					)

			------------------------------------------
			-- PLANO 3: FRONTAL
			------------------------------------------

			elseif phase < 3 then

				local a =
					phase - 2

				cameraPosition =
					rootCorredor.Position
					+ direction
					* (
						13
						- a * 3
					)

					+ Vector3.new(
						0,
						4.5,
						0
					)

				lookTarget =
					rootCorredor.Position
					+ Vector3.new(
						0,
						2.3,
						0
					)

			------------------------------------------
			-- PLANO 4: HERO SHOT
			------------------------------------------

			else

				local a =
					phase - 3

				cameraPosition =
					rootCorredor.Position
					- direction * 11

					+ rootCorredor.CFrame.RightVector
					* math.sin(
						a * math.pi
					) * 9

					+ Vector3.new(
						0,
						6
							+ math.sin(
								a * math.pi
							) * 2,
						0
					)

				lookTarget =
					rootCorredor.Position
					+ direction * 4

					+ Vector3.new(
						0,
						2.5,
						0
					)

			end

			--========================================
			-- CÁMARA SUAVE
			--========================================

			local desired =
				CFrame.lookAt(
					cameraPosition,
					lookTarget
				)

			camera.CFrame =
				camera.CFrame:Lerp(
					desired,
					math.clamp(
						dt
							* CAMERA_SMOOTH,
						0,
						1
					)
				)

			--========================================
			-- FOV
			--========================================

			local fov =
				FOV_BASE
				+ math.sin(
					t * math.pi
				)
				* (
					FOV_MAX
					- FOV_BASE
				)

			camera.FieldOfView =
				camera.FieldOfView
				+ (
					fov
					- camera.FieldOfView
				)
				* math.clamp(
					dt * 5,
					0,
					1
				)

			--========================================
			-- BOB
			--========================================

			local bob =
				math.sin(
					elapsed * 10
				)
				* 0.035

			camera.CFrame =
				camera.CFrame
				* CFrame.new(
					0,
					bob,
					0
				)

		end
	)

