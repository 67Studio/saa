local function crearTaco()

	local taco =
		Instance.new(
			"Part"
		)

	taco.Name =
		"TacoVolador"

	taco.Size =
		Vector3.new(
			2.6,
			1.1,
			2.2
		)

	taco.Color =
		Color3.fromRGB(
			225,
			175,
			55
		)

	taco.Material =
		Enum.Material.SmoothPlastic

	taco.CanCollide = false
	taco.CanTouch = false
	taco.CanQuery = false
	taco.Massless = false

	-- Forma de taco aproximada
	taco.Shape =
		Enum.PartType.Cylinder

	local relleno =
		Instance.new(
			"Part"
		)

	relleno.Name =
		"Relleno"

	relleno.Size =
		Vector3.new(
			1.8,
			0.7,
			1
		)

	relleno.Color =
		Color3.fromRGB(
			170,
			55,
			35
		)

	relleno.Material =
		Enum.Material.SmoothPlastic

	relleno.CanCollide = false
	relleno.CanTouch = false
	relleno.CanQuery = false

	relleno.Massless = true

	relleno.CFrame =
		taco.CFrame
		* CFrame.new(
			0,
			0.25,
			0
		)

	relleno.Parent =
		taco

	local weld =
		Instance.new(
			"WeldConstraint"
		)

	weld.Part0 = taco
	weld.Part1 = relleno

	weld.Parent = taco

	-- Brillo
	local light =
		Instance.new(
			"PointLight"
		)

	light.Color =
		Color3.fromRGB(
			255,
			190,
			60
		)

	light.Brightness = 0.8
	light.Range = 4

	light.Parent = taco

	return taco

end

