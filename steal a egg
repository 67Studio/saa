local tacoAccumulator = 0

local tacoConnection

tacoConnection =
	RunService.Heartbeat:Connect(
		function(dt)

			if not activo then
				return
			end

			if not rootCorredor.Parent then
				return
			end

			-- Acumulador preciso
			tacoAccumulator +=
				TACOS_POR_SEGUNDO * dt

			local cantidad =
				math.floor(
					tacoAccumulator
				)

			tacoAccumulator -=
				cantidad

			for i = 1, cantidad do

				local angle =
					math.random()
					* math.pi
					* 2

				local distance =
					math.sqrt(
						math.random()
					)
					* RADIO_LLUVIA

				local x =
					math.cos(angle)
					* distance

				local z =
					math.sin(angle)
					* distance

				local spawnPosition =
					rootCorredor.Position
					+ Vector3.new(
						x,
						ALTURA_CAIDA
							+ math.random(
								-15,
								15
							),
						z
					)

				local taco =
					crearTaco()

				taco.CFrame =
					CFrame.new(
						spawnPosition
					)
					* CFrame.Angles(
						math.random()
							* math.pi,
						math.random()
							* math.pi,
						math.random()
							* math.pi
					)

				taco.Parent =
					workspace

				taco.AssemblyLinearVelocity =
					Vector3.new(
						(math.random() - 0.5)
							* 8,

						-math.random(
							35,
							65
						),

						(math.random() - 0.5)
							* 8
					)

				taco.AssemblyAngularVelocity =
					Vector3.new(
						math.random(
							-10,
							10
						),

						math.random(
							-10,
							10
						),

						math.random(
							-10,
							10
						)
					)

				-- Al caer, generar pequeño efecto
				task.delay(
					1.2,
					function()

						if taco
							and taco.Parent then

							impactoTaco(
								taco.Position
							)

						end

					end
				)

				Debris:AddItem(
					taco,
					VIDA_TACO
				)

			end

		end
	)

--============================================================
-- CARRERA + CÁMARA
--============================================================

local direction =
	rootCorredor.CFrame.LookVector

direction =
	Vector3.new(
		direction.X,
		0,
		direction.Z
	).Unit

humCorredor.WalkSpeed =
	VELOCIDAD

