local shakeStart =
	os.clock()

while os.clock()
	- shakeStart
	< 0.35 do

	local progress =
		(
			os.clock()
			- shakeStart
		) / 0.35

	local strength =
		1 - progress

	local x =
		(
			math.random()
			- 0.5
		)
		* 0.12
		* strength

	local y =
		(
			math.random()
			- 0.5
		)
		* 0.12
		* strength

	camera.CFrame =
		camera.CFrame
		* CFrame.Angles(
			math.rad(y),
			math.rad(x),
			0
		)

	RunService.RenderStepped:Wait()

end

