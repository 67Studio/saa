		)

	particles.Texture =
		"rbxassetid://241396860"

	particles.Color =
		ColorSequence.new({
			ColorSequenceKeypoint.new(
				0,
				Color3.fromRGB(
					255,
					220,
					80
				)
			),

			ColorSequenceKeypoint.new(
				1,
				Color3.fromRGB(
					255,
					120,
					30
				)
			)
		})

	particles.Lifetime =
		NumberRange.new(
			0.2,
			0.45
		)

	particles.Speed =
		NumberRange.new(
			5,
			12
		)

	particles.SpreadAngle =
		Vector2.new(
			180,
			180
		)

	particles.Rate = 0

	particles.Size =
		NumberSequence.new({
			NumberSequenceKeypoint.new(
				0,
				0.5
			),

			NumberSequenceKeypoint.new(
				1,
				0
			)
		})

	particles.Parent =
		attachment

	particles:Emit(
		10
	)

	Debris:AddItem(
		attachment,
		1
	)

end

