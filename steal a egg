-- ============================================================
local function loadScale()
    if readfile and isfile then
        local ok, exists = pcall(isfile, CONFIG.ScaleFile)
        if ok and exists then
            local ok2, data = pcall(readfile, CONFIG.ScaleFile)
            if ok2 and data and data ~= "" then
                local n = tonumber(data)
                if n then return math.clamp(n, CONFIG.MinScale, CONFIG.MaxScale) end
            end
        end
    end
    local nv = LocalPlayer:FindFirstChild("NexusScale")
    if nv and nv:IsA("NumberValue") then
        return math.clamp(nv.Value, CONFIG.MinScale, CONFIG.MaxScale)
    end
    return 1
end

local function saveScale(scale)
    if writefile then
        pcall(function() writefile(CONFIG.ScaleFile, tostring(scale)) end)
    end
    local nv = LocalPlayer:FindFirstChild("NexusScale")
    if not nv then
        nv = Instance.new("NumberValue")
        nv.Name = "NexusScale"
        nv.Parent = LocalPlayer
    end
    nv.Value = scale
end

