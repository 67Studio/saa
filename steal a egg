local function antiHitTeleport()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    local savedCF   = Camera.CFrame
    local savedType = Camera.CameraType
    Camera.CameraType = Enum.CameraType.Scriptable
    Camera.CFrame = savedCF

    hum.BreakJointsOnDeath = false
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("Motor6D") then v.Enabled = true end
    end

    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    for _, cf in ipairs(SAFE_CFRAMES) do
        hum.PlatformStand = true
        hum.Health = 100
        hrp.CFrame = cf
        hrp.AssemblyLinearVelocity  = Vector3.zero
        Camera.CFrame = savedCF
        task.wait(0.02)
    end

    local elapsed = os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if os.clock() - elapsed > 0.35 then
            conn:Disconnect()
            return
        end
        hum.Health = 100
        hum.PlatformStand = true
        hrp.CFrame = SAFE_CFRAMES[#SAFE_CFRAMES]
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        Camera.CFrame = savedCF
    end)
    task.wait(0.35)
    hum.PlatformStand = false
    Camera.CameraType = savedType
end

local function applyPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    if ANTI_HIT_STATE.enabled then
        if ANTI_HIT_STATE.savedHoldDurations[prompt] == nil then
            ANTI_HIT_STATE.savedHoldDurations[prompt] = prompt.HoldDuration
        end
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
    elseif ANTI_HIT_STATE.savedHoldDurations[prompt] ~= nil then
        prompt.HoldDuration = ANTI_HIT_STATE.savedHoldDurations[prompt]
        ANTI_HIT_STATE.savedHoldDurations[prompt] = nil
    end
end

local function setAntiHit(enabled)
    if enabled then
        for _, d in ipairs(Workspace:GetDescendants()) do applyPrompt(d) end
        table.insert(ANTI_HIT_STATE.connections, Workspace.DescendantAdded:Connect(applyPrompt))
        table.insert(ANTI_HIT_STATE.connections, ProximityPromptSvc.PromptShown:Connect(applyPrompt))
        return
    end
    for _, c in ipairs(ANTI_HIT_STATE.connections) do
        if c then c:Disconnect() end
    end
    ANTI_HIT_STATE.connections = {}
    for prompt, dur in pairs(ANTI_HIT_STATE.savedHoldDurations) do
        if prompt and prompt.Parent then prompt.HoldDuration = dur end
    end
    ANTI_HIT_STATE.savedHoldDurations = {}
end

