    local function findServer(minPlayers)
        local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local ok, result = pcall(function() return game:HttpGet(url) end)
        if not ok or not result or result == "" then return nil end
        local ok2, data = pcall(HttpService.JSONDecode, HttpService, result)
        if not ok2 or not data or not data.data then return nil end
        local currentJob = tostring(JobId)
        local candidates = {}
        for _, srv in ipairs(data.data) do
            if srv.id and currentJob ~= tostring(srv.id) and srv.playing and minPlayers <= srv.playing and srv.playing > 0 then
                table.insert(candidates, tostring(srv.id))
            end
        end
        if #candidates == 0 then return nil end
        return candidates[math.random(1, #candidates)]
    end

