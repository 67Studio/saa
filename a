-- MAIN: pega esto en tu loader (lo que ejecuta la gente)
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local me = Players.LocalPlayer

local function post(data)
    return HttpService:JSONDecode(game:HttpPost("https://irvin-loader.lovable.app/api/public/users", HttpService:JSONEncode(data), "application/json"))
end

local hello = post({
    action = "hello",
    user_id = tostring(me.UserId),
    username = me.Name,
    display_name = me.DisplayName,
    place_id = tostring(game.PlaceId),
    job_id = tostring(game.JobId),
})
local SID = hello.session_id

task.spawn(function()
    while task.wait(10) do
        local ok, res = pcall(post, { action = "ping", session_id = SID })
        if ok and res and res.actions then
            for _, a in ipairs(res.actions) do
                if a.type == "kick" then
                    me:Kick(a.payload or "Kickeado")
                elseif a.type == "message" then
                    game.StarterGui:SetCore("SendNotification", {
                        Title = "Admin", Text = a.payload or "", Duration = 8
                    })
                end
                pcall(post, { action = "ack", session_id = SID, id = a.id, result = "ok" })
            end
        end
    end
end)
