local function RayfieldNotif(title, msg, duration)
    local p = game:GetService("Players").LocalPlayer
    local pGui = p:WaitForChild("PlayerGui")
    
    if pGui:FindFirstChild("Irvinglz1Notif") then
        pGui.Irvinglz1Notif:Destroy()
    end

    local notifGui = Instance.new("ScreenGui")
    notifGui.Name = "Irvinglz1Notif"
    notifGui.Parent = pGui
    notifGui.DisplayOrder = 999

    local mainNotif = Instance.new("Frame")
    mainNotif.Size = UDim2.new(0, 260, 0, 70)
    mainNotif.Position = UDim2.new(1, 30, 0.85, 0)
    mainNotif.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    mainNotif.BorderSizePixel = 0
    mainNotif.Parent = notifGui
    Instance.new("UICorner", mainNotif).CornerRadius = UDim.new(0, 6)

    local sideBar = Instance.new("Frame")
    sideBar.Size = UDim2.new(0, 4, 1, 0)
    sideBar.Position = UDim2.new(0, 0, 0, 0)
    sideBar.BorderSizePixel = 0
    sideBar.Parent = mainNotif
    Instance.new("UICorner", sideBar).CornerRadius = UDim.new(0, 6)

    task.spawn(function()
        while mainNotif and mainNotif.Parent do
            local hue = tick() % 4 / 4
            sideBar.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
            task.wait()
        end
    end)

    local tLabel = Instance.new("TextLabel")
    tLabel.Size = UDim2.new(1, -30, 0, 30)
    tLabel.Position = UDim2.new(0, 15, 0, 8)
    tLabel.Text = title or "Notification"
    tLabel.TextColor3 = Color3.new(1, 1, 1)
    tLabel.Font = Enum.Font.GothamBold
    tLabel.TextSize = 16
    tLabel.TextXAlignment = Enum.TextXAlignment.Left
    tLabel.BackgroundTransparency = 1
    tLabel.Parent = mainNotif

    local mLabel = tLabel:Clone()
    mLabel.Size = UDim2.new(1, -30, 0, 30)
    mLabel.Position = UDim2.new(0, 15, 0, 32)
    mLabel.Text = msg or "Message here"
    mLabel.Font = Enum.Font.Gotham
    mLabel.TextSize = 13
    mLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    mLabel.Parent = mainNotif

    mainNotif:TweenPosition(UDim2.new(1, -280, 0.10, 0), "Out", "Quint", 0.6, true)

    task.delay(duration or 5, function()
        if mainNotif then
            mainNotif:TweenPosition(UDim2.new(1, 30, 0.85, 0), "In", "Quint", 0.6, true)
            task.wait(0.6)
            notifGui:Destroy()
        end
    end)
end

